{
  "name": "dsh-model",
  "version": "0.15.1",
  "description": "Many model sources behind one authenticated OpenAI-compatible endpoint for DeepSeek Harness (dsh) and your tools: WorkBuddy, OpenCode Zen and your CLI subscriptions (Codex, Kimi…), with a management page inside dsh. 多家模型汇成一个 OpenAI 兼容地址，dsh 和其他软件都能直接用。",
  "keywords": [
    "dsh-plugin",
    "dsh-plugins",
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "deepseek",
    "cordis",
    "model-provider",
    "llm-gateway",
    "openai-compatible",
    "openai-api",
    "cli-subscription",
    "codex",
    "kimi",
    "workbuddy",
    "opencode",
    "cliproxyapi",
    "self-hosted",
    "llm-tools"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-model": "bin/dsh-model.js"
  },
  "files": [
    "bin",
    "dist",
    "plugin",
    "engine-manifest.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/engine-contract",
    "pin-engine": "node scripts/pin-engine.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/dsh-model.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "homepage": "https://github.com/AIcivilization/dsh-model#readme",
  "bugs": {
    "url": "https://github.com/AIcivilization/dsh-model/issues"
  },
  "author": "AIcivilization"
}
