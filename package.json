{
  "name": "dsh-model",
  "version": "0.3.1",
  "description": "One local, authenticated OpenAI-compatible endpoint for dsh and your tools: OpenCode Zen, WorkBuddy (own bridge) and your CLI subscriptions. Clean uninstall. Powered by CLIProxyAPI.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "model-provider",
    "openai-compatible",
    "cli-subscription",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-model": "bin/dsh-model.js"
  },
  "files": [
    "bin",
    "dist",
    "engine-manifest.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/engine-contract",
    "pin-engine": "node scripts/pin-engine.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/dsh-model.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
